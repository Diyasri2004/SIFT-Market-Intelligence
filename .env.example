# Server Configuration
PORT=4000
NODE_ENV=development

# Market Data Providers (Optional - high-fidelity resilient market engine used if empty)
# Finnhub API Key (Free tier 60 calls/minute: https://finnhub.io/)
FINNHUB_API_KEY=
# Twelve Data API Key (Free tier 8 calls/minute: https://twelvedata.com/)
TWELVE_DATA_API_KEY=
# Alpha Vantage API Key (Free tier 25 calls/day: https://www.alphavantage.co/)
ALPHA_VANTAGE_API_KEY=

# Thresholds Configuration
PRICE_MOVE_THRESHOLD_PERCENT=2.0
VOLUME_SPIKE_THRESHOLD_MULTIPLIER=1.5
POLL_INTERVAL_SECONDS=15
CACHE_TTL_SECONDS=30
STALE_THRESHOLD_SECONDS=120
